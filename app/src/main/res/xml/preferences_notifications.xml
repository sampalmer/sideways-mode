<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<CheckBoxPreference
		android:key="showNotification"
		android:title="@string/preference_show_notification"
		android:summary="@string/preference_show_notification_description"
		android:icon="@drawable/preference_visibility"
		/>

	<Preference
		android:key="allNotifications"
		android:persistent="false"
		android:title="@string/preference_all_notifications_title"
		android:icon="@drawable/preference_visibility"
		/>

	<!-- This can't depend on the "Show Notification" preference since it isn't always available -->
	<!-- TODO: Populate the entries programmatically to keep everything in sync -->
	<ListPreference
		android:key="notificationPriority"
		android:title="@string/preference_notification_priority_title"
		android:entries="@array/notification_priorities"
		android:entryValues="@array/notification_priority_values"
		android:dialogIcon="@drawable/preference_notification_priority"
		android:icon="@drawable/preference_notification_priority"
		/>

</PreferenceScreen>