<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">

	<Preference
		android:key="notifications"
		android:persistent="false"
		android:title="@string/preference_notifications"
		android:icon="@drawable/preference_notifications">

		<intent
			android:targetPackage="samuelpalmer.sensorautorotation"
			android:targetClass="samuelpalmer.sensorautorotation.processes.ui.preferences.notifications.NotificationsActivity" />

	</Preference>

	<Preference
		android:key="assist"
	    android:persistent="false"
	    android:title="@string/preference_assist"
	    android:summary="@string/preference_assist_description"
		android:icon="@drawable/preference_assist" />

</PreferenceScreen>