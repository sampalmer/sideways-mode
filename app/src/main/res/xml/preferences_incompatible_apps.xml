<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Using hard-coded order since the permission preference can be dynamically removed and re-added. -->
	<!-- The permission prompt is a preference rather than normal layout content to ensure that it scrolls with the rest of the content on small screen sizes. -->
	<samuelpalmer.sensorautorotation.processes.ui.preferences.incompatibleapps.PermissionTipViewPreference
		android:key="incompatibleAppsPermission"
		android:title="@string/permissions_needed_tip"
		android:persistent="false"
		android:order="0"
	/>

	<Preference
		android:key="incompatibleAppsDetails"
		android:summary="@string/preference_incompatible_apps_details"
		android:persistent="false"
	    android:selectable="false"
		android:order="1"
		/>

	<Preference
		android:key="incompatibleAppPackages"
		android:persistent="false"
		android:title="@string/preference_choose_apps"
		android:icon="@drawable/preference_apps"
		android:order="2">

		<intent
			android:targetPackage="samuelpalmer.sensorautorotation"
			android:targetClass="samuelpalmer.sensorautorotation.processes.ui.preferences.incompatibleapps.IncompatibleAppsChooserActivity" />

	</Preference>

</PreferenceScreen>