<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<!--TODO: Show a warning if any apps are selected but the accessibility service is disabled -->

	<Preference
		android:summary="Stops apps from using their own screen orientation preferences. The accessibility service must be enabled to use this feature."
		android:persistent="false"
	    android:selectable="false"
		/>

	<!-- TODO: Warn the user about the accessibility service wasting RAM if it's enabled unnecessarily. -->
	<!-- Maybe don't worry about showing the accessibility service as a control; maybe just show warnings where needed -->
	<CheckBoxPreference
		android:key="forcedOrientationAccessibilityService"
		android:title="Accessibility service"
		android:summary="Required to use this feature"
	    android:persistent="false"
	    android:icon="@drawable/accessibility_service"
		/>

	<Preference
		android:key="forcedOrientationAppPackages"
		android:persistent="false"
		android:title="Choose apps"
		android:icon="@drawable/apps">

		<intent
			android:targetPackage="samuelpalmer.sensorautorotation"
			android:targetClass="samuelpalmer.sensorautorotation.processes.ui.orientationenforcement.ForcedAppsChooserActivity" />

	</Preference>
</PreferenceScreen>