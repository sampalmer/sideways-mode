<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Using hard-coded order since the permission preference can be dynamically removed and re-added. -->
	<samuelpalmer.sensorautorotation.processes.ui.preferences.orientationenforcement.PermissionTipViewPreference
		android:key="forcedOrientationPermission"
		android:summary="@string/permissions_needed_tip"
		android:persistent="false"
		android:selectable="false"
		android:order="0"
	/>

	<Preference
		android:summary="@string/preference_forced_apps_details"
		android:persistent="false"
	    android:selectable="false"
		android:order="1"
		/>

	<Preference
		android:key="forcedOrientationAppPackages"
		android:persistent="false"
		android:title="@string/preference_choose_apps"
		android:icon="@drawable/preference_apps"
		android:order="2">

		<intent
			android:targetPackage="samuelpalmer.sensorautorotation"
			android:targetClass="samuelpalmer.sensorautorotation.processes.ui.preferences.orientationenforcement.ForcedAppsChooserActivity" />

	</Preference>

</PreferenceScreen>