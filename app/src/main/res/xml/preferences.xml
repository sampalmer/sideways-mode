<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">
	<CheckBoxPreference
		android:key="enabled"
	    android:title="@string/preference_enabled_title"
	    android:summary="@string/preference_enabled_description"
	    android:icon="@drawable/power"
	/>

	<!-- The "dependency" attribute needs to be specified for all children since setting it on the
	 PreferenceCategory alone doesn't work in the API 14 emulator -->
	<PreferenceCategory
		android:title="@string/preference_settings_title"
		android:dependency="enabled">
		<CheckBoxPreference
			android:key="showNotification"
			android:title="@string/show_notification"
			android:summary="@string/show_notification_description"
			android:icon="@drawable/show_notification"
			android:dependency="enabled"
			/>

		<ListPreference
			android:key="notificationPriority"
			android:title="@string/preference_notification_priority_title"
			android:entries="@array/notification_priorities"
			android:entryValues="@array/notification_priority_values"
			android:dialogIcon="@drawable/notification_priority"
			android:icon="@drawable/notification_priority"
			android:dependency="showNotification"
			/>

		<CheckBoxPreference
			android:key="allowUpsideDownScreen"
			android:title="@string/preference_allow_upside_down_screen_title"
			android:summary="@string/preference_allow_upside_down_screen_description"
			android:icon="@drawable/screen_upside_down"
			android:dependency="enabled"
			/>

		<PreferenceScreen
			android:key="forcedOrientationAppPackages"
			android:persistent="false"
			android:title="@string/preference_forced_apps_title"
			android:icon="@drawable/overridden_apps"
			android:dependency="enabled">

			<intent
				android:targetPackage="samuelpalmer.sensorautorotation"
				android:targetClass="samuelpalmer.sensorautorotation.processes.ui.orientationenforcement.ForcedAppsActivity" />

		</PreferenceScreen>
	</PreferenceCategory>
</PreferenceScreen>
