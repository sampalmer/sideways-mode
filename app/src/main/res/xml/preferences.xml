<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">
	<CheckBoxPreference
		android:key="enabled"
	    android:title="@string/app_enabled"
	    android:summary="@string/app_enabled_description"
	/>

	<CheckBoxPreference
		android:key="showNotification"
	    android:title="@string/show_notification"
	    android:summary="@string/show_notification_description"
		/>
	<ListPreference
		android:key="notificationPriority"
		android:title="@string/notification_priority"
		android:entries="@array/notification_priorities"
		android:entryValues="@array/notification_priority_values"
	    android:dependency="showNotification"
		/>

	<CheckBoxPreference
		android:key="allowUpsideDownScreen"
	    android:title="@string/allow_upside_down_screen"
	    android:summary="@string/allow_upside_down_screen_description"
	/>
	<ListPreference
		android:key="screenOnBehaviour"
	    android:title="@string/on_screen_off"
	    android:entries="@array/screen_off_behaviours"
	    android:entryValues="@array/screen_off_behaviour_values"
	/>
</PreferenceScreen>
