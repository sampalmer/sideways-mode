<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">
	<CheckBoxPreference
		android:key="enabled"
	    android:title="Enabled"
	    android:defaultValue="true"
	/>
	<CheckBoxPreference
		android:key="allowUpsideDownScreen"
	    android:title="Allow upside-down screen"
	    android:summary="Support use of the device while it is upside-down"
	    android:defaultValue="false"
	/>
	<ListPreference
		android:key="screenOnBehaviour"
	    android:title="On screen on"
	    android:entries="@array/screen_on_behaviours"
	    android:entryValues="@array/screen_on_behaviour_values"
	    android:defaultValue="DO_NOTHING"
	/>
</PreferenceScreen>
