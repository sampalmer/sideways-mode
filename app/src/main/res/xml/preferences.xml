<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">
	<CheckBoxPreference
		android:key="enabled"
	    android:title="@string/app_enabled"
	    android:summary="@string/app_enabled_description"
	/>
	<ListPreference
		android:key="notificationPriority"
		android:title="@string/notification_priority"
		android:entries="@array/notification_priorities"
		android:entryValues="@array/notification_priority_values"
		android:dialogIcon="@drawable/ic_notification_priority"
	    android:icon="@drawable/ic_notification_priority"
		/>
	<CheckBoxPreference
		android:key="allowUpsideDownScreen"
	    android:title="@string/allow_upside_down_screen"
	    android:summary="@string/allow_upside_down_screen_description"
	    android:icon="@drawable/ic_screen_upside_down"
	/>

</PreferenceScreen>
