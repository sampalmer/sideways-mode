<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">
	<CheckBoxPreference
		android:key="enabled"
	    android:title="@string/app_enabled"
	    android:summary="@string/app_enabled_description"
	/>
	<CheckBoxPreference
		android:key="allowUpsideDownScreen"
	    android:title="@string/allow_upside_down_screen"
	    android:summary="@string/allow_upside_down_screen_description"
	/>
	<ListPreference
		android:key="screenOnBehaviour"
	    android:title="@string/on_screen_off"
	    android:entries="@array/screen_off_behaviours"
	    android:entryValues="@array/screen_off_behaviour_values"
	/>
	<CheckBoxPreference
		android:key="showNotificationAtTop"
	    android:title="@string/show_notification_at_top"
	    android:summary="@string/show_notification_at_top_description"
	/>
	<samuelpalmer.sensorautorotation.orientationenforcement.ui.AppPackagesPreference
		android:key="forcedOrientationAppPackages"
		android:title="Forced apps"
		android:summary="Apps for which orientation should be enforced"
		/>
</PreferenceScreen>
