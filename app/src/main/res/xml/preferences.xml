<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android">

	<PreferenceCategory android:title="@string/preference_controls" android:summary="controlling the screen orientation!">

		<Preference
			android:key="notifications"
			android:persistent="false"
			android:title="@string/preference_notifications"
			android:icon="@drawable/preference_notifications" />

		<Preference
			android:key="quick_setting"
			android:persistent="false"
			android:title="@string/preference_quick_setting"
			android:icon="@drawable/preference_quick_settings" />

		<Preference
			android:key="assist"
			android:persistent="false"
			android:title="@string/preference_assist"
			android:summary="@string/preference_assist_description"
			android:icon="@drawable/preference_assist" />

		<Preference
			android:key="small_app"
			android:persistent="false"
			android:title="@string/preference_small_app"
			android:summary="@string/preference_small_app_description"
			android:icon="@drawable/preference_small_app" />

	</PreferenceCategory>

	<PreferenceCategory android:title="@string/settings">

		<CheckBoxPreference
			android:key="allowUpsideDownScreen"
			android:title="@string/preference_allow_upside_down_screen_title"
			android:summary="@string/preference_allow_upside_down_screen_description"
			android:icon="@drawable/preference_screen_upside_down"
			/>

		<PreferenceScreen
			android:key="forcedOrientationAppPackages"
			android:persistent="false"
			android:title="@string/preference_forced_apps_title"
			android:icon="@drawable/preference_overridden_apps"
			>

			<intent
				android:targetPackage="samuelpalmer.sensorautorotation"
				android:targetClass="samuelpalmer.sensorautorotation.processes.ui.preferences.orientationenforcement.ForcedAppsActivity" />

		</PreferenceScreen>

	</PreferenceCategory>

</PreferenceScreen>
