<samuelpalmer.sensorautorotation.processes.ui.ControlPanelView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:gravity="center_horizontal"
	android:padding="@dimen/dialog_content_margin"
	>

	<!-- TODO: Maybe use the support library to get the look good and consistent. Also see specs: https://material.google.com/components/dialogs.html#dialogs-specs -->
	<!-- TODO: Also show user's current orientation -->

	<!-- TODO: Maybe make the background a bit transparent -->
	<!-- TODO: Maybe make the progress bar fade in and out to reduce flicker -->
	<ProgressBar
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:id="@+id/control_panel_progress"
		android:visibility="gone"
	    style="@android:style/Widget.DeviceDefault.ProgressBar.Large"
		/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:id="@+id/control_panel_contents"
		android:gravity="center_horizontal"
		>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/control_panel_status"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="?android:attr/textColorPrimary"
			android:textStyle="bold"
		    android:gravity="center_horizontal"
		    android:paddingBottom="20dp"

			/>

		<!-- TODO: Make the buttons bigger. Maybe we'll need to add bigger button icons? -->
		<LinearLayout
			android:layout_height="match_parent"
		    android:layout_width="match_parent"
		    android:orientation="horizontal"
			android:layoutDirection="ltr"
			android:id="@+id/control_panel_controls"
			tools:ignore="UnusedAttribute">

			<ImageButton
				android:id="@+id/control_panel_button_rotate_left"
				android:scaleType="center"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				style="@android:style/Widget.DeviceDefault.Button.Borderless"
				android:src="@drawable/control_panel_rotate_left"
			    android:contentDescription="@string/action_rotate_left"
				/>

			<!-- TODO: Fix issue where background blinks when this is pressed on Samsung Galaxy S5 (Android 6) due to toast -->
			<ImageButton
				android:id="@+id/control_panel_button_toggle"
				android:scaleType="center"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				style="@android:style/Widget.DeviceDefault.Button.Borderless"
				tools:ignore="ContentDescription"/>

			<ImageButton
				android:id="@+id/control_panel_button_rotate_right"
				android:scaleType="center"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:src="@drawable/control_panel_rotate_right"
				style="@android:style/Widget.DeviceDefault.Button.Borderless"
				android:contentDescription="@string/action_rotate_left"
				/>

		</LinearLayout>

	</LinearLayout>

</samuelpalmer.sensorautorotation.processes.ui.ControlPanelView>
