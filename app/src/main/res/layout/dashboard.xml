<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<ImageButton
		android:id="@+id/dashboard_settings"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		android:layout_alignParentStart="true"
		android:layout_alignParentLeft="true"
		android:contentDescription="@string/settings"
		android:background="@android:color/transparent"
		/>

	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="@dimen/dialog_content_margin">

		<ProgressBar
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/dashboard_progress"
			android:visibility="gone"
		    style="@android:style/Widget.DeviceDefault.ProgressBar.Large"
		    android:layout_centerInParent="true"
			/>

		<samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardDisabledContents
			android:id="@+id/dashboard_disabled"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:visibility="gone"
			/>

		<samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardEnabledContents
			android:id="@+id/dashboard_enabled_contents"
			android:layout_width="match_parent"
		    android:layout_height="wrap_content"
			/>

	</RelativeLayout>

</RelativeLayout>
