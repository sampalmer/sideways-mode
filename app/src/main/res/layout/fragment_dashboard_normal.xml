<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:gravity="center_horizontal"
	>

	<LinearLayout
		android:layout_height="match_parent"
		android:layout_width="wrap_content"
		android:layout_marginLeft="36dp"
		android:layout_marginRight="36dp"
		android:orientation="horizontal"
		android:paddingBottom="20dp"
		>

		<ProgressBar
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/dashboard_sensor_progress"
			android:layout_gravity="center_vertical"
			android:visibility="gone"
			style="@android:style/Widget.DeviceDefault.ProgressBar.Small"
			/>

		<View
			android:layout_width="6dp"
			android:layout_height="match_parent" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/dashboard_status"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="?android:attr/textColorPrimary"
			android:textStyle="bold"
			android:gravity="center_horizontal"
		    />

	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
	    android:layoutDirection="ltr"
		tools:ignore="UnusedAttribute">

		<ImageButton
			android:id="@+id/dashboard_button_left_side"
			style="@style/ExclusiveButton"
			app:srcCompat="@drawable/dashboard_left_side"
			android:contentDescription="@string/user_rotation_left_side"
		    android:background="@drawable/toggle_button_background_left"
			/>

		<ImageButton
			android:id="@+id/dashboard_button_turn_off"
			style="@style/ExclusiveButton"
			app:srcCompat="@drawable/dashboard_turn_off"
			android:contentDescription="@string/action_turn_off"
			android:background="@drawable/toggle_button_background_middle"
			/>

		<ImageButton
			android:id="@+id/dashboard_button_right_side"
			style="@style/ExclusiveButton"
			app:srcCompat="@drawable/dashboard_right_side"
			android:contentDescription="@string/user_rotation_right_side"
			android:background="@drawable/toggle_button_background_right"
			/>

	</LinearLayout>

</LinearLayout>