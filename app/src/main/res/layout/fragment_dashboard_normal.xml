<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    android:orientation="vertical"
    >

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/dialog_content_margin"
        android:layout_gravity="center"
        >

        <LinearLayout
            android:id="@+id/dashboard_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/dashboard_normal_waiting_sensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_waiting_sensor"
                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                    />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/dashboard_sensor_progress"
                    android:indeterminate="true"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="?attr/listPreferredItemHeight"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                tools:ignore="UnusedAttribute">

                <samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardButtonView
                    android:id="@+id/dashboard_button_left_side"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/user_rotation_left_side"
                    app:src="@drawable/dashboard_left_side"
                    />

                <!-- Spacer -->
                <View android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_weight="1"
                      android:visibility="invisible"/>

                <samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardButtonView
                    android:id="@+id/dashboard_button_turn_off"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/action_turn_off"
                    app:src="@drawable/dashboard_turn_off"
                    />

                <!-- Spacer -->
                <View android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_weight="1"
                      android:visibility="invisible"/>

                <samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardButtonView
                    android:id="@+id/dashboard_button_right_side"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/user_rotation_right_side"
                    app:src="@drawable/dashboard_right_side"
                    />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:id="@+id/dashboard_progress"
            android:visibility="invisible"
            />

    </RelativeLayout>

    <!--
        Using a CoordinatorLayout so the error can be swiped away.
        Not putting other content in it so the snackbar uses its own space rather than overlapping other content.
        This is separate from the other views so it doesn't get any padding.
     -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/dashboard_error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
