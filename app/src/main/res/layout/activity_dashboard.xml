<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content">

	<ImageButton
		android:id="@+id/dashboard_settings"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_marginLeft="12dp"
		android:layout_marginStart="12dp"
		android:layout_marginTop="12dp"
		style="@style/Widget.AppCompat.Button.Borderless"
		app:srcCompat="@drawable/dashboard_settings"
		android:contentDescription="@string/settings"
		/>

	<RelativeLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="@dimen/dialog_content_margin"
		android:layout_centerInParent="true"
	    android:gravity="center"
		>

		<ProgressBar
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/dashboard_progress"
			android:visibility="gone"
			android:layout_centerInParent="true"
			style="@android:style/Widget.DeviceDefault.ProgressBar.Large"
			/>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			>

			<TextView
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:layout_marginLeft="36dp"
				android:layout_marginRight="36dp"
				android:paddingBottom="20dp"
				android:textAppearance="@style/TextAppearance.AppCompat.Title"
				android:text="@string/app_name_full"
			/>

			<fragment
				android:name="samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardPermissionFragment"
				android:id="@+id/dashboard_permission"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:visibility="gone"
				/>

			<fragment
				android:name="samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardNormalFragment"
				android:id="@+id/dashboard_normal_contents"
				android:layout_width="match_parent"
			    android:layout_height="wrap_content"
				/>

		</LinearLayout>

	</RelativeLayout>

</RelativeLayout>
