<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content">

	<ImageButton
		android:id="@+id/dashboard_settings"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_alignParentTop="true"
		android:layout_alignParentStart="true"
		android:layout_alignParentLeft="true"
		style="@style/Widget.AppCompat.Button.Borderless"
		app:srcCompat="@drawable/menu_settings"
		android:contentDescription="@string/settings"
		/>

	<RelativeLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="@dimen/dialog_content_margin"
		android:layout_centerInParent="true"
	    android:gravity="center"
		>

		<ProgressBar
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/dashboard_progress"
			android:visibility="gone"
			android:layout_centerInParent="true"
			style="@android:style/Widget.DeviceDefault.ProgressBar.Large"
			/>

		<fragment
			android:name="samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardPermissionFragment"
			android:id="@+id/dashboard_permission"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:visibility="gone"
			/>

		<fragment
			android:name="samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardDisabledFragment"
			android:id="@+id/dashboard_disabled_contents"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:visibility="gone"
			/>

		<fragment
			android:name="samuelpalmer.sensorautorotation.processes.ui.dashboard.DashboardEnabledFragment"
			android:id="@+id/dashboard_enabled_contents"
			android:layout_width="wrap_content"
		    android:layout_height="wrap_content"
			/>

	</RelativeLayout>

</RelativeLayout>
