<?xml version="1.0" encoding="utf-8"?>

<ImageButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/AppTheme"
    android:scaleType="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/selectableItemBackground"
    android:padding="0dp"
    android:minWidth="48dp"
    android:minHeight="0dp"
    tools:ignore="ContentDescription"
    />


<!-- The theme is needed to make selectableItemBackground work in Android 5+ -->
<!-- Using Android selectableItemBackground since our own one crashes prior to Android 5 -->
<!-- Min-height is zeroed to override style that sets it to 48dp, which is taller than Samsung Galaxy S10 Android 10 min notification height -->
