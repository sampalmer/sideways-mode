<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".processes.ui.MessageActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            tools:ignore="UselessParent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:gravity="center_horizontal"
                >

                <!-- Taking inspiration from https://github.com/vlonjatg/progress-activity/blob/a326767de15d30a3819f32bfacf635e1bb4c63ca/library/src/main/res/layout/view_error.xml -->

                <ImageView
                    android:id="@+id/message_image"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:tint="?colorPrimary"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/image_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:textAppearance="?textAppearanceBody1"
                    android:id="@+id/message_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:textAlignment="center"
                    tools:text="@string/device_problem"
                    />

                <TextView
                    android:textAppearance="?textAppearanceBody2"
                    android:id="@+id/message_explanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="56dp"
                    android:layout_marginRight="56dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:textAlignment="center"
                    tools:text="@string/device_problem_explanation_sensor"
                    />

                <Button
                    android:id="@+id/message_button_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_got_it"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>
</LinearLayout>
