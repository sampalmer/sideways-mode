<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/notification_background"
    >

    <FrameLayout
        android:id="@+id/notification_left_side_button_container"
        style="@style/AppTheme.NotificationButtonContainer"
        >
        <ImageButton
            android:id="@+id/notification_left_side_button"
            android:contentDescription="@string/user_rotation_left_side"
            style="@style/AppTheme.NotificationButton" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.DarkTheme" android:id="@+id/notification_left_side_progress_on_colour_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.LightTheme" android:id="@+id/notification_left_side_progress_on_colour_light_theme" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notification_turn_off_button_container"
        style="@style/AppTheme.NotificationButtonContainer"
        >
        <ImageButton
            android:id="@+id/notification_turn_off_button"
            android:contentDescription="@string/action_turn_off"
            style="@style/AppTheme.NotificationButton"
            android:scaleX="0"
            />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.DarkTheme" android:id="@+id/notification_turn_off_progress_on_colour_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.LightTheme" android:id="@+id/notification_turn_off_progress_on_colour_light_theme" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notification_right_side_button_container"
        style="@style/AppTheme.NotificationButtonContainer"
        >
        <ImageButton
            android:id="@+id/notification_right_side_button"
            android:contentDescription="@string/user_rotation_right_side"
            style="@style/AppTheme.NotificationButton" />

        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.DarkTheme" android:id="@+id/notification_right_side_progress_on_colour_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.LightTheme" android:id="@+id/notification_right_side_progress_on_colour_light_theme" />
    </FrameLayout>

</merge>