<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/notification_left_side_button_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        >
        <include layout="@layout/notification_button" android:id="@+id/notification_left_side_button" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.DarkTheme" android:id="@+id/notification_left_side_progress_on_colour_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.LightTheme" android:id="@+id/notification_left_side_progress_on_colour_light_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.Selected.DarkTheme" android:id="@+id/notification_left_side_progress_selected_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.Selected.LightTheme" android:id="@+id/notification_left_side_progress_selected_light_theme" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notification_turn_off_button_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        >
        <include layout="@layout/notification_button" android:id="@+id/notification_turn_off_button" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.DarkTheme" android:id="@+id/notification_turn_off_progress_on_colour_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.LightTheme" android:id="@+id/notification_turn_off_progress_on_colour_light_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.Selected.DarkTheme" android:id="@+id/notification_turn_off_progress_selected_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.Selected.LightTheme" android:id="@+id/notification_turn_off_progress_selected_light_theme" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notification_right_side_button_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        >
        <include layout="@layout/notification_button" android:id="@+id/notification_right_side_button" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.DarkTheme" android:id="@+id/notification_right_side_progress_on_colour_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.OnColour.LightTheme" android:id="@+id/notification_right_side_progress_on_colour_light_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.Selected.DarkTheme" android:id="@+id/notification_right_side_progress_selected_dark_theme" />
        <ProgressBar style="@style/AppTheme.Notification.ProgressBar.Selected.LightTheme" android:id="@+id/notification_right_side_progress_selected_light_theme" />
    </FrameLayout>

</merge>