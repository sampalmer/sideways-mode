<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content">

	<ImageButton
		android:id="@+id/dashboard_settings"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		android:layout_alignParentStart="true"
		android:layout_alignParentLeft="true"
		android:contentDescription="@string/settings"
		android:background="@android:color/transparent"
		/>

	<RelativeLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="@dimen/dialog_content_margin">

		<ProgressBar
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/dashboard_progress"
			android:visibility="gone"
		    style="@android:style/Widget.DeviceDefault.ProgressBar.Large"
		    android:layout_centerInParent="true"
			/>

		<LinearLayout
			android:layout_width="wrap_content"
		    android:layout_height="wrap_content"
		    android:id="@+id/dashboard_disabled"
			android:visibility="gone"
		    android:orientation="vertical"
			android:gravity="center_horizontal"
			>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/dashboard_disabled_text"
				android:textAppearance="?android:attr/textAppearanceMedium"
				android:textColor="?android:attr/textColorPrimary"
				android:textStyle="bold"
				android:gravity="center_horizontal"
				/>

			<Button
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/dashboard_disabled_view_error"
				android:text="@string/app_disabled_view_error"
				/>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:id="@+id/dashboard_contents"
			android:gravity="center_horizontal"
			>

			<LinearLayout
				android:layout_height="match_parent"
				android:layout_width="wrap_content"
				android:orientation="horizontal"
				android:paddingBottom="20dp"
				>

				<ImageView
					android:layout_width="wrap_content"
				    android:layout_height="wrap_content"
				    android:id="@+id/dashboard_user_icon"
				    android:scaleType="centerInside"
					tools:ignore="ContentDescription"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:id="@+id/dashboard_status"
					android:textAppearance="?android:attr/textAppearanceMedium"
					android:textColor="?android:attr/textColorPrimary"
					android:textStyle="bold"
				    android:gravity="center_horizontal"
					/>

			</LinearLayout>

			<LinearLayout
				android:layout_height="match_parent"
			    android:layout_width="match_parent"
			    android:orientation="horizontal"
				android:layoutDirection="ltr"
				android:id="@+id/dashboard_controls"
				tools:ignore="UnusedAttribute">

				<ImageButton
					android:id="@+id/dashboard_button_rotate_left"
					android:scaleType="center"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					style="@style/Widget.AppCompat.Button.Borderless"
					android:contentDescription="@string/action_rotate_left"
					/>

				<ImageButton
					android:id="@+id/dashboard_button_toggle"
					android:scaleType="center"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					style="@style/Widget.AppCompat.Button.Borderless"
					tools:ignore="ContentDescription"/>

				<ImageButton
					android:id="@+id/dashboard_button_rotate_right"
					android:scaleType="center"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					style="@style/Widget.AppCompat.Button.Borderless"
					android:contentDescription="@string/action_rotate_left"
					/>

			</LinearLayout>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/dashboard_mode"
				android:textAppearance="?android:attr/textAppearanceSmall"
				android:textColor="?android:attr/textColorSecondary"
				/>

		</LinearLayout>

	</RelativeLayout>

</RelativeLayout>
