<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context="samuelpalmer.sensorautorotation.processes.ui.SendFeedbackActivity">

	<!-- A CardView that contains a TextView -->
	<android.support.v7.widget.CardView
		xmlns:card_view="http://schemas.android.com/apk/res-auto"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<!-- TODO: Colour the icons of all items present -->

		<android.support.design.widget.NavigationView
			android:id="@+id/feedback_navigation"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:menu="@menu/menu_feedback" />

	</android.support.v7.widget.CardView>

	<!-- TODO: Make the background behind the card grey like in Google apps -->
	<!-- TODO: Remove scrolling shade thing when trying to scroll inside the card -->

</RelativeLayout>
