<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              style="@style/notification"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
	>

	<include layout="@layout/notification_content" />

	<LinearLayout
		style="@style/notification_buttons"
		android:layoutDirection="ltr"
    >

        <include layout="@layout/notification_button" android:id="@+id/rotate_left_button" />
        <include layout="@layout/notification_button" android:id="@+id/toggle_mode_button" />
        <include layout="@layout/notification_button" android:id="@+id/rotate_right_button" />

    </LinearLayout>

</LinearLayout>
