<?xml version="1.0" encoding="utf-8"?>

<!-- The notification container layout height on Android 4 doesn't work with "match_parent", so we have to set the height explicitly -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppTheme.NotificationContainer"
    android:layout_width="match_parent"
    android:layout_height="@android:dimen/notification_large_icon_height"
    >

    <include layout="@layout/notification_buttons" />

</LinearLayout>
