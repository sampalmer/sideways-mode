<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	android:id="@+id/activity_report_problem"
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context="samuelpalmer.sensorautorotation.processes.ui.feedback.ReportProblemActivity">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="@dimen/activity_vertical_margin"
		android:paddingLeft="@dimen/activity_horizontal_margin"
		android:paddingRight="@dimen/activity_horizontal_margin"
		android:paddingTop="@dimen/activity_vertical_margin"
		android:orientation="vertical">

		<!--
		I want the user to first see and understand the entire form before they start writing,
		so we we'll have the keyboard closed by default.
		-->
		<View
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:focusable="true"
			android:focusableInTouchMode="true"
			/>

		<!--
			Not using material design TextInputLayout because:
			1. It doesn't match the material design spec
			2. It introduces visual clutter in error state
			3. It has wrong colours when in error state
			4. No editor hint in full screen view (landscape)
		-->

		<EditText
			android:id="@+id/problem_steps"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/report_problem_reproduce"
			android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
			/>

		<androidx.legacy.widget.Space
			android:layout_width="match_parent"
			android:layout_height="16dp"/>

		<EditText
			android:id="@+id/problem_problem"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/report_problem_problem"
			android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
			/>

		<androidx.legacy.widget.Space
			android:layout_width="match_parent"
			android:layout_height="16dp"/>

		<EditText
			android:id="@+id/problem_expected"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/report_problem_expected"
			android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
			/>

		<androidx.legacy.widget.Space
			android:layout_width="match_parent"
			android:layout_height="16dp"/>

		<!-- This notice is required by Google Play (https://play.google.com/about/privacy-security/user-data/) -->
		<TextView
			android:id="@+id/feedback_disclosure"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/report_problem_disclosure"
			/>

	</LinearLayout>

</ScrollView>
