<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_centerVertical="true"
		tools:ignore="UselessParent"
		tools:context="samuelpalmer.sensorautorotation.processes.ui.DeviceUnsupportedActivity"
		>

		<LinearLayout
			android:layout_width="wrap_content"
		    android:layout_height="wrap_content"
		    android:orientation="vertical"
			android:paddingLeft="@dimen/activity_horizontal_margin"
			android:paddingRight="@dimen/activity_horizontal_margin"
			android:paddingTop="@dimen/activity_vertical_margin"
			android:paddingBottom="@dimen/activity_vertical_margin"
			>

			<TextView
				android:id="@+id/device_unsupported_explanation"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:gravity="center_horizontal"
				android:text="@string/device_problem_explanation_sensor"
				android:textAppearance="@style/TextAppearance.AppCompat.Medium"
			    android:textAlignment="center"
				android:paddingBottom="@dimen/activity_vertical_margin"
				/>

			<ImageView
				android:layout_width="match_parent"
				android:layout_height="100dp"
				app:srcCompat="@drawable/image_broken_phone"
				android:tint="@color/primary_500"
				android:scaleType="fitCenter"
			    android:alpha=".8"
				android:contentDescription="@string/device_problem"/>

			<TextView
				android:paddingTop="@dimen/activity_vertical_margin"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:gravity="center_horizontal"
				android:text="@string/request_uninstall"
				android:textAppearance="@style/TextAppearance.AppCompat.Medium"
				android:textAlignment="center"
				/>

			<Button
				android:id="@+id/device_unsupported_uninstall"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/action_uninstall"
			    android:layout_gravity="center_horizontal"
				/>

		</LinearLayout>

	</ScrollView>

</RelativeLayout>