<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:id="@+id/forced_apps_activity"
    >

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/forced_apps_tip_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#e5e5e5"
	    android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
	    >

        <TextView
            android:id="@+id/conversation_tip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@android:color/primary_text_light"
            android:textSize="16sp"
            />

	    <Button
		    android:id="@+id/forced_apps_accessibility_service_enable"
		    android:layout_width="wrap_content"
		    android:layout_height="wrap_content"
		    android:layout_gravity="center_vertical|right|end"
		    android:text="@string/preference_accessibility_service_enable"
		    />

    </LinearLayout>

    <fragment
        android:id="@+id/settings"
        android:name="samuelpalmer.sensorautorotation.processes.ui.orientationenforcement.ForcedAppsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    />

</LinearLayout>