<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary_500_light">#795548</color>

    <color name="primary_500">@color/primary_500_light</color>
    <color name="primary_700">#4b2c20</color>
    <color name="accent_700">#0091EA</color>
    <color name="tip_view_background">#e5e5e5</color>

    <!-- Using either white or black so the icon has plenty of contrast over the primary-coloured background -->
    <color name="notification_button_icon_on_colour_dark_theme">@android:color/black</color>
    <color name="notification_button_icon_on_colour_light_theme">@android:color/white</color>


    <!-- Icon opacity values taken from https://material.io/archive/guidelines/style/color.html#color-usability -->

    <!-- 100% white -->
    <color name="notification_button_icon_selected_dark_theme">@android:color/white</color>

    <!-- 54% black -->
    <color name="notification_button_icon_selected_light_theme">#8A000000</color>

    <!-- 50% white -->
    <color name="notification_button_icon_unselected_dark_theme">#80FFFFFF</color>

    <!-- 38% black -->
    <color name="notification_button_icon_unselected_light_theme">#61000000</color>


    <!-- Background colour opacity values taken from https://material.io/design/color/dark-theme.html#states and https://material.io/design/interaction/states.html#activated -->

    <!-- 12% white -->
    <color name="notification_button_background_selected_dark_theme">#1FFFFFFF</color>

    <!-- 12% black -->
    <color name="notification_button_background_selected_light_theme">#1F000000</color>

</resources>