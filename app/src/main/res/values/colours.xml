<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary_500_dark">#be9c91</color>
    <color name="primary_500_light">#795548</color>

    <color name="primary_500">@color/primary_500_light</color>
    <color name="primary_700">#4b2c20</color>
    <color name="accent_700">#0091EA</color>
    <color name="tip_view_background">#e5e5e5</color>

    <!-- Unfortunately, different devices use different background colours. So we'll just match the stock Android background colour for a basic level of consistency. -->
    <color name="notification_background">#181818</color>

    <color name="notification_button_container_selected">@color/primary_500_dark</color>

    <color name="notification_button_icon_unselected_dark_theme">@android:color/white</color>
    <color name="notification_button_icon_unselected_light_theme">@android:color/black</color>
    <color name="notification_button_icon_unselected">@color/notification_button_icon_unselected_dark_theme</color>

    <!-- Using either white or black so the icon has plenty of contrast over the primary-coloured background -->
    <color name="notification_button_icon_on_colour_dark_theme">@android:color/black</color>
    <color name="notification_button_icon_on_colour_light_theme">@android:color/white</color>
    <color name="notification_button_icon_on_colour">@color/notification_button_icon_on_colour_dark_theme</color>

</resources>