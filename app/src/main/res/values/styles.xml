<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryDark">@color/primary_700</item>
        <item name="colorAccent">@color/accent_700</item>

        <!-- Needed for the preference support library -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        
        <item name="toolbarStyle">@style/AppTheme.Toolbar</item>
        <item name="drawerArrowStyle">@style/AppTheme.DrawerArrowToggle</item>
    </style>
    
    <style name="AppTheme.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <!-- For some reason, the toolbar text defaults to black on brown, which doesn't have enough contrast -->
        <item name="titleTextColor">@android:color/white</item>
    </style>

    <style name="AppTheme.DrawerArrowToggle" parent="Widget.AppCompat.DrawerArrowToggle">
        <!-- For some reason, the toolbar arrow defaults to black on brown, which doesn't have enough contrast -->
        <item name="color">@android:color/white</item>
    </style>

    <style name="AppTheme.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryDark">@color/primary_700</item>
        <item name="colorAccent">@color/accent_700</item>

        <!-- Prevents the dialog from being rendered weirdly in the recents screen. -->
        <item name="android:windowNoDisplay">true</item>

        <!-- Prevents the window title from animating out when the dialog is closed. -->
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Invisible; activity appears to not exist -->
    <style name="AppTheme.Translucent">
        <!-- This must be "false" to ensure the accessibility service picks up the the next activity once this one closes on API 27. -->
        <item name="android:windowIsTranslucent">false</item>

        <!-- *DO NOT* null out the window animation style, since that causes a black flicker when the activity starts or finishes on API 27. -->
        <!-- <item name="android:windowAnimationStyle">@null</item> -->

        <!-- This must be "false" to ensure the accessibility service picks up the the next activity once this one closes on API 27. -->
        <item name="android:windowDisablePreview">false</item>

        <!-- This prevents the status bar from animating out when this activity closes. -->
        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent</item>

        <!-- This ensures the activity doesn't appear as solid-white while it loads. -->
        <item name="android:windowBackground">@android:color/transparent</item>

        <!-- This must be "false" to ensure the accessibility service picks up the activity on APIs 14 - 22. -->
        <item name="android:windowNoDisplay">false</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- This prevents the navigation bar from flickering -->
        <item name="android:windowTranslucentNavigation" tools:targetApi="kitkat">true</item>
    </style>

    <style name="Base.AppTheme.Notification.ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:indeterminate">true</item>
    </style>

    <style name="AppTheme.NotificationButtonContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/notification_button_container_background</item>
    </style>

    <style name="AppTheme.NotificationButton">
        <!-- The theme is needed to make selectableItemBackground work in Android 5+ -->
        <item name="android:theme">@style/AppTheme</item>
        <item name="android:scaleType">center</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>

        <!-- Using Android selectableItemBackground since our own one crashes prior to Android 5 -->
        <item name="android:background">?android:attr/selectableItemBackground</item>

        <item name="android:padding">0dp</item>
        <item name="android:minWidth">48dp</item>

        <!-- Min-height is zeroed to override style that sets it to 48dp, which is taller than Samsung Galaxy S10 Android 10 min notification height -->
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="AppTheme.Notification.ProgressBar" parent="Base.AppTheme.Notification.ProgressBar" />

    <!-- Using specific drawables since this is the only way to do it prior to API 21 -->
    <style name="AppTheme.Notification.ProgressBar.OnColour.DarkTheme" parent="AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/notification_button_progress_on_colour_dark_theme</item>
    </style>

    <style name="AppTheme.Notification.ProgressBar.OnColour.LightTheme" parent="AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/notification_button_progress_on_colour_light_theme</item>
    </style>

</resources>