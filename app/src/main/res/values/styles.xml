<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- Base application theme. -->
	<style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
		<item name="colorPrimary">@color/primary_500</item>
		<item name="colorPrimaryDark">@color/primary_700</item>
		<item name="colorAccent">@color/accent_700</item>
	</style>

	<style name="AppTheme.Dialog" parent="Theme.AppCompat.Light.Dialog">
		<item name="colorPrimary">@color/primary_500</item>
		<item name="colorPrimaryDark">@color/primary_700</item>
		<item name="colorAccent">@color/accent_700</item>

		<!-- Prevents the dialog from being rendered weirdly in the recents screen. -->
		<item name="android:windowNoDisplay">true</item>

		<!-- Prevents the window title from animating out when the dialog is closed. -->
		<item name="windowNoTitle">true</item>
	</style>

	<style name="AppTheme.Navigation" parent="AppTheme">
		<item name="android:windowBackground">@color/grey_300</item>
	</style>

	<style name="notification">
		<item name="android:baselineAligned">false</item>
	</style>

	<style name="notification_buttons">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">match_parent</item>
		<item name="android:layout_weight">0</item>
		<item name="android:baselineAligned">false</item>
	</style>

</resources>