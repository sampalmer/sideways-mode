<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Notification.ProgressBar" parent="Base.AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateTintMode">src_in</item>
    </style>

    <!-- Using tints so we can stick with the OS default progress bar while retaining our own colours -->
    <style name="AppTheme.Notification.ProgressBar.OnColour.DarkTheme" parent="AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateTint">@color/notification_button_icon_on_colour_dark_theme</item>
    </style>

    <style name="AppTheme.Notification.ProgressBar.OnColour.LightTheme" parent="AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateTint">@color/notification_button_icon_on_colour_light_theme</item>
    </style>

    <style name="AppTheme.Notification.ProgressBar.Selected.DarkTheme" parent="AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateTint">@color/notification_button_icon_selected_dark_theme</item>
    </style>

    <style name="AppTheme.Notification.ProgressBar.Selected.LightTheme" parent="AppTheme.Notification.ProgressBar">
        <item name="android:indeterminateTint">@color/notification_button_icon_selected_light_theme</item>
    </style>

</resources>