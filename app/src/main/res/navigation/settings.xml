<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/nav_graph"
    app:startDestination="@id/incompatibleAppsFragment">

    <fragment
        android:id="@+id/incompatibleAppsFragment"
        android:name="samuelpalmer.sensorautorotation.processes.ui.preferences.incompatibleapps.IncompatibleAppsFragment"
        android:label="@string/preference_incompatible_apps_title" >
        <action
            android:id="@+id/action_incompatibleAppsFragment_to_incompatibleAppsChooserFragment"
            app:destination="@+id/incompatibleAppsChooserFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/incompatibleAppsChooserFragment"
        android:name="samuelpalmer.sensorautorotation.processes.ui.preferences.incompatibleapps.IncompatibleAppsChooserFragment"
        android:label="@string/preference_incompatible_apps_title" />

</navigation>