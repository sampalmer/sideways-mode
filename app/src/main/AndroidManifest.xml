<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="samuelpalmer.sensorautorotation"
		android:installLocation="internalOnly">

	<!-- For some reason, RtlViewPager requires API 15, but it still seems to work OK on 14 (from my brief testing) -->
	<uses-sdk tools:overrideLibrary="com.booking.widget.rtlviewpager" />

	<!-- To disable system rotation, set user rotation -->
	<uses-permission android:name="android.permission.WRITE_SETTINGS" />

	<!-- For the screen orientation enforcement overlay -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

	<uses-permission android:name="com.sony.smallapp.permission.SMALLAPP" />

	<uses-feature
		android:name="android.hardware.sensor.accelerometer"
		android:required="true" />
	<uses-feature
		android:name="android.hardware.sensor.gyroscope"
	    android:required="false" />

	<uses-feature
		android:name="android.hardware.screen.landscape"
		android:required="true" />
	<uses-feature
		android:name="android.hardware.screen.portrait"
		android:required="true" />

	<application
		android:name=".CurrentProcess"
		android:allowBackup="true"
		android:icon="@mipmap/launcher"
		android:label="@string/app_name"
		android:theme="@style/AppTheme"
		android:fullBackupContent="@xml/backupscheme"
		android:supportsRtl="true"
		android:appCategory="productivity"
		tools:ignore="GoogleAppIndexingWarning"
		tools:targetApi="o">

		<!-- Main Process -->

		<activity
			android:name=".processes.ui.instructions.InstructionsActivity"
			android:label="@string/instructions_heading"
			android:parentActivityName=".processes.ui.preferences.MainSettingsActivity"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.preferences.MainSettingsActivity" />

		</activity>

		<activity
			android:name=".processes.ui.preferences.MainSettingsActivity"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<intent-filter>
				<action android:name="android.intent.action.APPLICATION_PREFERENCES" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>

			<intent-filter>
				<action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
			</intent-filter>

		</activity>

		<activity android:name=".processes.ui.MessageDialogActivity"
			android:theme="@style/AppTheme.Dialog"/>

		<activity
			android:name=".processes.ui.preferences.orientationenforcement.ForcedAppsActivity"
			android:parentActivityName=".processes.ui.preferences.MainSettingsActivity"
			android:label="@string/preference_forced_apps_title"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.preferences.MainSettingsActivity" />

		</activity>

		<activity
			android:name=".processes.ui.preferences.orientationenforcement.ForcedAppsChooserActivity"
			android:parentActivityName=".processes.ui.preferences.orientationenforcement.ForcedAppsActivity"
			android:configChanges="orientation|keyboardHidden|screenSize"
			android:label="@string/preference_forced_apps_title"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.preferences.orientationenforcement.ForcedAppsActivity" />

		</activity>

		<activity
			android:name=".processes.ui.feedback.SendFeedbackActivity"
			android:parentActivityName=".processes.ui.preferences.MainSettingsActivity"
			android:label="@string/action_feedback"
			android:theme="@style/AppTheme.Navigation"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="samuelpalmer.sensorautorotation.processes.ui.preferences.MainSettingsActivity"/>

		</activity>

		<activity
			android:name=".processes.ui.feedback.ReportProblemActivity"
			android:parentActivityName=".processes.ui.feedback.SendFeedbackActivity"
		    android:windowSoftInputMode="stateVisible"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.feedback.SendFeedbackActivity" />

		</activity>

		<!--suppress AndroidDomInspection -->
		<service
			android:name=".processes.ui.DashboardSmallApp"
			android:exported="true"
			tools:ignore="ExportedService">
			<intent-filter>
				<action android:name="com.sony.smallapp.intent.action.MAIN" />
				<category android:name="com.sony.smallapp.intent.category.LAUNCHER" />
			</intent-filter>
		</service>

		<!--
			This is in the UI process since its popup dialog uses a fair bit of RAM, and we can't use
			the activity as an alternative since Android blocks activity launches for 5 seconds after
			the last home button press.
		 -->
		<service
			android:name=".processes.ui.QuickSettingService"
			android:icon="@drawable/app_right_side"
			android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
			>
			<intent-filter>
				<action android:name="android.service.quicksettings.action.QS_TILE" />
			</intent-filter>
		</service>

		<!-- Intentionally allowing history on this activity so you can return to it after granting permission -->
		<activity android:name=".processes.ui.dashboard.DashboardActivity"
		          android:launchMode="singleInstance"
		          android:excludeFromRecents="true"
		          android:taskAffinity=""
		          android:theme="@style/AppTheme.Dialog"
		          android:configChanges="orientation|screenSize|screenLayout"
		          tools:ignore="UnusedAttribute">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>

			<intent-filter>
				<action android:name="android.intent.action.ASSIST" />
				<category android:name="android.intent.category.DEFAULT"/>
			</intent-filter>

			<meta-data android:name="com.android.systemui.action_assist_icon" android:resource="@drawable/assist_orb" />

		</activity>

		<activity
			android:name=".processes.ui.DeviceUnsupportedActivity"
			android:label="@string/device_problem" />


		<!-- Service Process -->

		<provider
			android:authorities="@string/preferences_provider_authority"
			android:name="samuelpalmer.common.contentprovidersharedpreferences.SharedPreferencesContentProvider"
			android:exported="false"
			android:process="@string/service_process_name" />

		<service
			android:name=".processes.service.ApplicationStatusService"
			android:exported="false"
			android:process="@string/service_process_name" />

		<receiver android:name=".processes.service.UpgradeReceiver"
		          android:process="@string/service_process_name">
			<intent-filter>
				<action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
			</intent-filter>
		</receiver>

		<receiver android:name=".processes.service.DummyReceiver"
		          android:process="@string/service_process_name" />

		<receiver android:name=".processes.service.api.ApplicationCommandReceiver"
		          android:process="@string/service_process_name" />

		<service
			android:name=".processes.service.RotationService"
			android:enabled="true"
			android:exported="false"
			android:process="@string/service_process_name" />

		<activity
			android:name=".processes.service.DummyActivity"
			android:theme="@android:style/Theme.NoDisplay"
			android:enabled="true"
			android:allowTaskReparenting="true"
			android:noHistory="true"
			android:excludeFromRecents="true"
			android:alwaysRetainTaskState="false"
			android:stateNotNeeded="true"
			android:clearTaskOnLaunch="true"
			android:finishOnTaskLaunch="true"
			android:taskAffinity=""
			android:process="@string/service_process_name"
			/>

		<service
			android:name=".processes.service.WindowChangeDetectingService"
			android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
			android:process="@string/service_process_name">
			<intent-filter>
				<action android:name="android.accessibilityservice.AccessibilityService"/>
			</intent-filter>
			<meta-data
				android:name="android.accessibilityservice"
				android:resource="@xml/accessibilityservice"/>
		</service>

		<uses-library android:name="com.sony.smallapp.framework" android:required="false" />
	</application>

</manifest>
