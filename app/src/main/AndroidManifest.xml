<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="samuelpalmer.sensorautorotation"
		android:installLocation="internalOnly">

	<!-- To disable system rotation, set user rotation -->
	<uses-permission android:name="android.permission.WRITE_SETTINGS" />

	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="com.sony.smallapp.permission.SMALLAPP" />

	<uses-feature
		android:name="android.hardware.sensor.accelerometer"
		android:required="true" />
	<uses-feature
		android:name="android.hardware.screen.landscape"
		android:required="true" />
	<uses-feature
		android:name="android.hardware.screen.portrait"
		android:required="true" />

	<application
		android:name=".Process"
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:theme="@style/Theme"
		>

		<!-- Main Process -->

		<activity
			android:name=".processes.ui.instructions.InstructionsActivity"
			android:configChanges="orientation|screenSize"
			android:label="@string/instructions_heading"
			android:parentActivityName=".processes.ui.SettingsActivity"
			tools:ignore="UnusedAttribute" />

		<activity
			android:name=".processes.ui.SettingsActivity"
			android:configChanges="orientation|screenSize"
		>
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity android:name=".processes.ui.DialogActivity"
			android:theme="@style/Theme.NoDisplay"/>

		<activity
			android:name=".processes.ui.ShortcutActivity"
		    android:label="@string/toggle_rotation_lock"
		>
			<intent-filter>
				<action android:name="android.intent.action.CREATE_SHORTCUT" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>

		<receiver android:name=".processes.ui.ToastReceiver" />

		<receiver android:name=".processes.service.ServiceDisabler"
		          android:process=":samuelpalmer.sensorautorotation.service" />

		<!-- Service Process -->

		<receiver android:name=".processes.service.UpgradeReceiver"
		          android:process=":samuelpalmer.sensorautorotation.service">
			<intent-filter>
				<action android:name="android.intent.action.PACKAGE_REPLACED" />
				<data
					android:scheme="package"
					android:path="samuelpalmer.sensorautorotation" />
			</intent-filter>
		</receiver>

		<receiver android:name=".processes.service.EnsureAppLoadedReceiver"
		          android:process=":samuelpalmer.sensorautorotation.service">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>

		<activity
			android:name=".processes.service.ToggleRotationLockActivity"
			android:exported="true"
			android:label="Toggle Rotation Lock"
			android:theme="@android:style/Theme.NoDisplay"
			android:launchMode="singleTask"
			android:taskAffinity=""
			android:excludeFromRecents="true"
			android:process=":samuelpalmer.sensorautorotation.service" />

		<receiver android:name=".processes.service.ToggleRotationLockReceiver"
		          android:process=":samuelpalmer.sensorautorotation.service" />

		<service
			android:name=".processes.service.RotationService"
			android:enabled="true"
			android:exported="false"
			android:process=":samuelpalmer.sensorautorotation.service" />

		<uses-library android:name="com.sony.smallapp.framework" android:required="false" />

		<!--suppress AndroidDomInspection -->
		<service
			android:name=".processes.service.ToggleRotationLockSmallApp"
			android:exported="true"
			tools:ignore="ExportedService"
			android:process=":samuelpalmer.sensorautorotation.service">
			<intent-filter>
				<action android:name="com.sony.smallapp.intent.action.MAIN" />
				<category android:name="com.sony.smallapp.intent.category.LAUNCHER" />
			</intent-filter>
		</service>
	</application>

</manifest>
