<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="samuelpalmer.sensorautorotation"
		android:installLocation="internalOnly">

	<!-- To disable system rotation, set user rotation -->
	<uses-permission android:name="android.permission.WRITE_SETTINGS" />

	<!-- For the screen orientation enforcement overlay -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="com.sony.smallapp.permission.SMALLAPP" />

	<uses-feature
		android:name="android.hardware.sensor.accelerometer"
		android:required="true" />
	<uses-feature
		android:name="android.hardware.sensor.gyroscope"
	    android:required="false" />

	<uses-feature
		android:name="android.hardware.screen.landscape"
		android:required="true" />
	<uses-feature
		android:name="android.hardware.screen.portrait"
		android:required="true" />

	<application
		android:name=".CurrentProcess"
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name_full"
		android:theme="@style/AppTheme"
		android:fullBackupContent="@xml/backupscheme"
		tools:ignore="GoogleAppIndexingWarning">

		<!-- Main Process -->

		<activity android:name=".processes.ui.FirstRunActivity" />

		<activity
			android:name=".processes.ui.instructions.InstructionsActivity"
			android:label="@string/instructions_heading"
			android:parentActivityName=".processes.ui.MainActivity"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.MainActivity" />

		</activity>

		<activity
			android:name=".processes.ui.MainActivity"
			android:label="@string/app_name"
		    android:launchMode="singleTask"
		>
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>

			<intent-filter>
				<action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
			</intent-filter>
		</activity>

		<activity android:name=".processes.ui.MessageDialogActivity"
			android:theme="@style/Theme.NoDisplay"/>

		<activity
			android:name=".processes.ui.ShortcutActivity"
		    android:label="@string/action_toggle_rotation_lock"
		>
			<intent-filter>
				<action android:name="android.intent.action.CREATE_SHORTCUT" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>

		<receiver android:name=".processes.ui.ToastReceiver" />

		<activity
			android:name=".processes.ui.preferences.ControlsActivity"
			android:parentActivityName=".processes.ui.MainActivity"
			android:label="@string/preference_controls"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.MainActivity" />

		</activity>

		<activity
			android:name=".processes.ui.preferences.notifications.NotificationsActivity"
			android:parentActivityName=".processes.ui.preferences.ControlsActivity"
			android:label="@string/preference_notifications"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.NOTIFICATION_PREFERENCES" />
			</intent-filter>

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.preferences.ControlsActivity" />

		</activity>

		<activity
			android:name=".processes.ui.preferences.orientationenforcement.ForcedAppsActivity"
			android:parentActivityName=".processes.ui.MainActivity"
			android:label="@string/preference_forced_apps_title"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.MainActivity" />

		</activity>

		<activity
			android:name=".processes.ui.preferences.orientationenforcement.ForcedAppsChooserActivity"
			android:parentActivityName=".processes.ui.preferences.orientationenforcement.ForcedAppsActivity"
			android:configChanges="orientation|keyboardHidden|screenSize"
			android:label="@string/preference_forced_apps_title"
			android:launchMode="singleTask"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.preferences.orientationenforcement.ForcedAppsActivity" />

		</activity>

		<activity
			android:name=".processes.ui.SendFeedbackActivity"
			android:parentActivityName=".processes.ui.MainActivity"
			android:label="@string/action_feedback"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="samuelpalmer.sensorautorotation.processes.ui.MainActivity"/>

		</activity>

		<activity
			android:name=".processes.ui.ReportProblemActivity"
			android:parentActivityName=".processes.ui.SendFeedbackActivity"
			android:label="@string/action_report"
		    android:windowSoftInputMode="stateVisible"
			tools:ignore="UnusedAttribute">

			<!-- Parent activity meta-data to support 4.0 and lower -->
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value=".processes.ui.SendFeedbackActivity" />

		</activity>

		<!--suppress AndroidDomInspection -->
		<service
			android:name=".processes.ui.ControlPanelSmallApp"
			android:label="@string/app_name"
			android:exported="true"
			tools:ignore="ExportedService">
			<intent-filter>
				<action android:name="com.sony.smallapp.intent.action.MAIN" />
				<category android:name="com.sony.smallapp.intent.category.LAUNCHER" />
			</intent-filter>
		</service>

		<!--
			This is in the UI process since its popup dialog uses a fair bit of RAM, and we can't use
			the activity as an alternative since Android blocks activity launches for 5 seconds after
			the last home button press.
		 -->
		<service
			android:name=".processes.service.QuickSettingService"
			android:label="@string/app_name_full"
			android:icon="@drawable/rotation"
			android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
			>
			<intent-filter>
				<action android:name="android.service.quicksettings.action.QS_TILE" />
			</intent-filter>
		</service>

		<activity android:name=".processes.ui.controlpanel.ControlPanelActivity"
		          android:launchMode="singleInstance"
		          android:excludeFromRecents="true"
		          android:taskAffinity=""
		          android:theme="@style/Theme.NoDisplay"
		          android:showOnLockScreen="true"
		          android:noHistory="true"
		          android:configChanges="orientation|screenSize"
		          tools:ignore="UnusedAttribute">

			<intent-filter>
				<action android:name="android.intent.action.ASSIST" />
				<category android:name="android.intent.category.DEFAULT"/>
			</intent-filter>

			<meta-data android:name="com.android.systemui.action_assist_icon" android:resource="@drawable/assist" />

		</activity>

		<!-- Service Process -->

		<provider
			android:authorities="@string/preferences_provider_authority"
			android:name="samuelpalmer.common.contentprovidersharedpreferences.SharedPreferencesContentProvider"
			android:exported="false"
			android:process="@string/service_process_name" />

		<provider
			android:authorities="@string/status_provider_authority"
			android:name=".processes.service.ServiceStatusContentProvider"
			android:exported="false"
			android:process="@string/service_process_name" />

		<receiver android:name=".processes.service.StartUpReceiver"
		          android:process="@string/service_process_name">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
			</intent-filter>
		</receiver>

		<receiver android:name=".processes.service.ServiceSyncReceiver"
		          android:process="@string/service_process_name" />

		<activity
			android:name=".components.ToggleRotationLockActivity"
			android:exported="true"
			android:label="Toggle Rotation Lock"
			android:theme="@android:style/Theme.NoDisplay"
			android:launchMode="singleTask"
			android:taskAffinity=""
			android:excludeFromRecents="true"
			android:process="@string/service_process_name" />

		<receiver android:name=".processes.service.RotationServiceReceiver"
		          android:process="@string/service_process_name" />

		<service
			android:name=".processes.service.RotationService"
			android:enabled="true"
			android:exported="false"
			android:process="@string/service_process_name" />

		<service android:name=".processes.service.ServiceNotificationHider"
		         android:process="@string/service_process_name" />

		<activity
			android:name=".processes.service.DummyActivity"
			android:theme="@android:style/Theme.NoDisplay"
			android:enabled="true"
			android:allowTaskReparenting="true"
			android:noHistory="true"
			android:excludeFromRecents="true"
			android:alwaysRetainTaskState="false"
			android:stateNotNeeded="true"
			android:clearTaskOnLaunch="true"
			android:finishOnTaskLaunch="true"
			android:taskAffinity=""
			android:process="@string/service_process_name"
			/>

		<service
			android:label="@string/accessibility_service_name"
			android:name=".processes.service.WindowChangeDetectingService"
			android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
			android:process="@string/service_process_name">
			<intent-filter>
				<action android:name="android.accessibilityservice.AccessibilityService"/>
			</intent-filter>
			<meta-data
				android:name="android.accessibilityservice"
				android:resource="@xml/accessibilityservice"/>
		</service>

		<uses-library android:name="com.sony.smallapp.framework" android:required="false" />
	</application>

</manifest>
