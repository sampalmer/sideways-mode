<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="samuelpalmer.memoryhog" >

    <application
        android:allowBackup="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:largeHeap="true"
        tools:ignore="GoogleAppIndexingWarning">
        <activity
            android:name=".MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".BackgroundService1" android:process=":service1"/>
        <service android:name=".BackgroundService2" android:process=":service2"/>
        <service android:name=".BackgroundService3" android:process=":service3"/>
        <service android:name=".BackgroundService4" android:process=":service4"/>
        <service android:name=".BackgroundService5" android:process=":service5"/>
        <service android:name=".BackgroundService6" android:process=":service6"/>
        <service android:name=".BackgroundService7" android:process=":service7"/>
        <service android:name=".BackgroundService8" android:process=":service8"/>
        <service android:name=".BackgroundService9" android:process=":service9"/>
        <service android:name=".BackgroundService10" android:process=":service10"/>

    </application>

</manifest>
